{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplugins.dev/hermes-agent-maker/manifest.schema.json",
  "title": "NormalizedArtifactSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "mode", "summary", "target", "template_version"],
  "properties": {
    "kind": { "enum": ["skill", "native-plugin", "portable-plugin", "soul", "agents", "user-draft", "memory-draft"] },
    "mode": { "enum": ["preview", "apply"] },
    "name": { "$ref": "#/$defs/packageName" },
    "overwrite": { "type": "boolean" },
    "summary": { "$ref": "#/$defs/summary" },
    "target": { "$ref": "#/$defs/safeRelativePath" },
    "template_version": { "const": "1.0.0" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["skill", "native-plugin", "portable-plugin"] } }, "required": ["kind"] }, "then": { "required": ["name"] }, "else": { "not": { "required": ["name"] } } },
    { "if": { "properties": { "kind": { "const": "portable-plugin" } }, "required": ["kind"] }, "then": { "properties": { "summary": { "maxLength": 280 } } } },
    { "if": { "properties": { "kind": { "const": "soul" } }, "required": ["kind"] }, "then": { "properties": { "target": { "const": "SOUL.md" } } } },
    { "if": { "properties": { "kind": { "const": "agents" } }, "required": ["kind"] }, "then": { "properties": { "target": { "const": "AGENTS.md" } } } },
    { "if": { "properties": { "kind": { "const": "user-draft" } }, "required": ["kind"] }, "then": { "properties": { "target": { "const": "USER.md.draft.md" } } } },
    { "if": { "properties": { "kind": { "const": "memory-draft" } }, "required": ["kind"] }, "then": { "properties": { "target": { "const": "MEMORY.md.draft.md" } } } }
  ],
  "$defs": {
    "packageName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-][A-Za-z0-9._/-]*$" },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!.*\\.[Ee][Nn][Vv]\\b)(?!.*\\b(?:[Ii][Nn][Ss][Tt][Aa][Ll][Ll](?:[Aa][Tt][Ii][Oo][Nn])?|[Ll][Oo][Gg][Ii][Nn]|[Pp][Rr][Oo][Ff][Ii][Ll][Ee]|[Tt][Rr][Uu][Ss][Tt]|[Ee][Nn][Aa][Bb][Ll][Ee](?:[Mm][Ee][Nn][Tt])?|[Rr][Ee][Mm][Oo][Vv][Ee]|[Gg][Aa][Tt][Ee][Ww][Aa][Yy]|[Dd][Ii][Ss][Cc][Oo][Rr][Dd]|[Bb][Oo][Tt]|[Aa][Dd][Aa][Pp][Tt][Ee][Rr]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Tt][Oo][Kk][Ee][Nn][Ss]?|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][ _-]?[Kk][Ee][Yy]|[Aa][Pp][Ii][ _-]?[Kk][Ee][Yy]|[Nn][Ee][Tt][Ww][Oo][Rr][Kk]|[Ee][Xx][Tt][Ee][Rr][Nn][Aa][Ll][ _-]?[Tt][Rr][Aa][Nn][Ss][Mm][Ii][Ss][Ss][Ii][Oo][Nn]|[Dd][Yy][Nn][Aa][Mm][Ii][Cc][ _-]?[Ss][Cc][Hh][Ee][Mm][Aa]|[Ss][Cc][Hh][Ee][Mm][Aa][ _-]?(?:[Ff][Ee][Tt][Cc][Hh]|[Rr][Ee][Tt][Rr][Ii][Ee][Vv][Aa][Ll]))\\b)[A-Za-z0-9][^\\r\\n\"'\\\\:{}\\[\\]<>#&*!|%@`]*$"
    }
  }
}
